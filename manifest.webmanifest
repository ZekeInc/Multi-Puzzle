{
  "name": "Sudoku",
  "short_name": "Sudoku",
  "description": "A simple Sudoku game with no ads.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f7f9",
